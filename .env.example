# Gemini Developer API. Keep the real key in .env, which is ignored by Git.
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional: immutable Hugging Face model revision. Blank resolves and records HEAD.
HF_TOKEN=
E5_SMALL_REVISION=

# Local chat model used for query expansion and grounded answering.
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434
