# Secrets and optional runtime overrides. Defaults are in src/helpers/config.py.
GOOGLE_API_KEY=
GROQ_TOKEN=
HF_TOKEN=

# In auto mode, use Ollama if its configured server has this model; otherwise use Groq.
LLM_PROVIDER=auto
OLLAMA_MODEL=qwen2.5:7b
# Compose defaults to Docker Desktop's host service; override for another Ollama endpoint.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OLLAMA_PROBE_TIMEOUT_SECONDS=1.5

# MLflow Compose service and runtime config lookup.
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_CONFIG_MODEL=arabic-legal-rag-config
MLFLOW_CONFIG_ALIAS=champion
MLFLOW_CONFIG_REQUIRED=false
MLFLOW_MIN_FAITHFULNESS=0.75

# Optional self-hosted Langfuse tracing (start with compose.langfuse.yaml).
# Add the Langfuse project keys from its UI before enabling tracing.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_TRACING_ENVIRONMENT=development
# If true, traces include question, prompt/context, and answer text. Keep false
# unless you have reviewed the privacy implications for user-submitted questions.
LANGFUSE_CAPTURE_CONTENT=false
